{
  "name": "dsh-token-prune",
  "version": "0.5.0",
  "description": "Prunes a session's input tokens at the source: read any file by line range or symbol mention instead of whole, and bound oversized tool results at the boundary while keeping a recovery path. Unlike compression, it stops unneeded content from entering the context at all.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./ingest": "./ingest.js",
    "./archive": "./archive.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "ingest.js", "archive.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "README.zh.md"],
  "icon": "./icon.svg",
  "keywords": ["deepseek-harness", "dsh", "dsh-plugin", "token", "context", "precise-read", "tool-catalog"],
  "engines": { "dsh": ">=0.2.0" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/songrui111/dsh-token-prune.git"
  },
  "homepage": "https://github.com/songrui111/dsh-token-prune#readme",
  "bugs": {
    "url": "https://github.com/songrui111/dsh-token-prune/issues"
  },
  "scripts": {
    "test": "node test/run-all.mjs",
    "measure:reads": "node test/ab-measure.mjs",
    "measure:page": "node test/c-live-measure.mjs",
    "measure:session": "node test/session-measure.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  }
}
